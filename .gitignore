# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Build output
frontend/dist/

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Screenshots (generated, not source code)
screenshots/

# Environment secrets (never commit)
backend/.env

# SQLite WAL auxiliary files (auto-managed by SQLite, not needed in git)
*.db-shm
*.db-wal

# Temp files (root-level only — created for Playwright screenshots)
screenshot.mjs
